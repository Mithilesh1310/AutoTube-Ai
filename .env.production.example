# ==============================================================================
# AutoTube AI — Production Environment Variables Configuration Template
# ==============================================================================

# --- Server & Core Security ---
APP_ENV=production
PORT=8000
SECRET_KEY=generate_a_random_64_character_hex_string_for_production
JWT_SECRET=generate_another_random_64_character_hex_string_for_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OAUTH_ENCRYPTION_KEY=gAAAAABl-generate_32_byte_base64_fernet_key_here=
TIMEZONE=Asia/Kolkata

# --- Database & Caching ---
# SQLite with WAL mode (Default) or PostgreSQL (Recommended for high concurrency)
DATABASE_URL=sqlite+aiosqlite:///./autotube.db
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/autotubedb
REDIS_URL=redis://localhost:6379/0

# --- Frontend URL ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- AI Engines & Providers ---
GEMINI_API_KEY=your_gemini_api_key_here
VOICE_PROVIDER=edge_tts
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=your_pollinations_api_key_if_subscribed
VISUAL_PROVIDER=image_kenburns

# Optional Pluggable Animation (Luma / Fal AI / Replicate)
ANIMATION_PROVIDER=fal_ai
FAL_KEY=your_fal_ai_key_here

# --- Google Cloud & YouTube OAuth API ---
YOUTUBE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_REDIRECT_URI=https://api.yourdomain.com/api/v1/youtube/callback
YOUTUBE_PUBLISH_MODE=PUBLIC

# --- SaaS Billing Gateways (Stripe & Razorpay) ---
BILLING_SANDBOX_MODE=false

# Stripe Production Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Production Keys (India / International)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_live_secret

# --- Cloud Storage (Cloudflare R2 / AWS S3) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_r2_access_key
# S3_SECRET_KEY=your_r2_secret_key
# S3_BUCKET_NAME=autotube-production-assets
