# ===================================================
# AutoTube AI SaaS Production Environment Configuration
# ===================================================

# --- Core Server & Security ---
PORT=8000
SECRET_KEY=autotube_secret_encryption_key_change_in_production_min32chars
ENVIRONMENT=production

# --- AI Core Models ---
# Google Gemini API key (for topic research, devanagari scripting, QA gates)
GEMINI_API_KEY=your_gemini_api_key_here

# Fal AI Key (for 3D cartoon video animation & FLUX image generation)
FAL_KEY=your_fal_ai_key_here

# ElevenLabs Key (Optional: for ultra-realistic cloned voices, EdgeTTS is built-in free)
ELEVENLABS_API_KEY=

# --- YouTube OAuth 2.0 Credentials (Google Cloud Console) ---
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback

# --- SaaS Payment Gateways (Stripe & Razorpay) ---
# Stripe (Global credit/debit card subscriptions)
STRIPE_SECRET_KEY=sk_test_placeholder_or_live
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_or_live
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Razorpay (India: UPI, NetBanking, RuPay, Paytm)
RAZORPAY_KEY_ID=rzp_test_placeholder_or_live
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_or_live
RAZORPAY_WEBHOOK_SECRET=

# --- Autonomous Scheduling ---
AUTONOMOUS_SCHEDULE_ENABLED=true
DAILY_SHORTS_PUBLISH_TIME=10:00
DAILY_LONG_PUBLISH_TIME=18:00
TIMEZONE=Asia/Kolkata
